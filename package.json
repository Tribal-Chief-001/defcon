    "csv-parse": "^7.0.3",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.3",
    "shapefile": "^0.6.6",
    "tailwindcss": "^4.3.3",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
